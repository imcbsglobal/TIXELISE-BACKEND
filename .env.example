DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=tixelise.trelliscoerp.com,localhost,127.0.0.1
# Database. Leave DB_ENGINE unset for SQLite (development default).
# Switch to PostgreSQL with:
# DB_ENGINE=postgres
# POSTGRES_DB=TRELLISCO_BOOKS
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_OPTIONS="-c search_path=tixelise,public"
# or, on a hosting platform, with a single URL (it takes precedence):
# DATABASE_URL=postgres://user:password@localhost:5432/tixelise
# Sessions last 1 year by default: 525600 minutes = 365 days.
# Shorten both before a public production launch.
ACCESS_TOKEN_MINUTES=525600
REFRESH_TOKEN_DAYS=365
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://tixelise.trelliscoerp.com
# Required for the Django admin over https; the DRF API is JWT-only.
CSRF_TRUSTED_ORIGINS=https://tixelise.trelliscoerp.com
# Tenant creation registers the tenant's currency in the central currency
# master. Set to false to disable those outbound calls entirely.
CENTRAL_CURRENCY_SYNC_ENABLED=true
# Tenant creation registers the first tenant admin in the central user master;
# tenant deletion removes that account again. Set to false to disable both.
CENTRAL_USER_SYNC_ENABLED=true
